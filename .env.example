# For Docker Compose you do NOT need a .env — the stack works out of the box
# (`docker compose up -d --build`). This file is for local `npm run dev` and for
# optionally passing the keys below into the container (via env_file in
# docker-compose.yml). When running the app against the Dockerized DB locally,
# use host port 5433: postgresql://postgres:postgres@localhost:5433/cyshield
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cyshield"
PORT=5000
NODE_ENV=development

# Turnkey admin seeded on first run (docker-compose defaults to these). Change them.
SEED_ADMIN_EMAIL=admin@cyshield.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Threat intelligence API keys (for IP enrichment in reports and Intelligence)
ABUSEIPDB_API_KEY=your_abuseipdb_key
VIRUSTOTAL_API_KEY=your_virustotal_key

# Optional: AI (Ollama) – local LLM for insights, enrichment, report summaries
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=tinyllama
# OLLAMA_ENABLED=1

# Optional: Tavily – web search for AI insights threat intel (https://tavily.com)
# TAVILY_API_KEY=your_tavily_key

# Optional: NVD (NIST) API key for CVE lookup – 50 req/30s with key vs 5 req/30s without
# Get key at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your_nvd_key

# Optional: Admin API key for admin endpoints (without this, admin routes are localhost-only)
# ADMIN_API_KEY=your_secret_admin_key

# Optional: tune Node/TypeScript behavior
# LOG_LEVEL=info

# ── Scan concurrency ──────────────────────────────────────────────────────────
# Concurrent scans across the WHOLE deployment, enforced with Postgres advisory
# locks (server/scan-slots.ts). Each held slot occupies a pooled connection, so
# keep the database pool comfortably above this number.
# SCAN_CONCURRENCY=3
# How long a scan waits for a slot before giving up.
# SCAN_SLOT_WAIT_MS=1200000

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Login / register / scan limits are shared across instances via the rate_limits
# table, so they are a global budget rather than per-process. No configuration
# needed; the table is created by db:push.

# ── SLA ───────────────────────────────────────────────────────────────────────
# How often overdue findings are swept and flagged. Deadlines come from
# SLA_HOURS in server/finding-workflow.ts (critical 24h, high 168h, ...).
# SLA_CHECK_INTERVAL_MS=3600000

# ── Ransomware leak-site exposure ─────────────────────────────────────────────
# Public, keyless corpus of leak-site victim postings. No API key required.
# RANSOMWARE_FEED_URL=https://data.ransomware.live/posts.json
# RANSOMWARE_FEED_TTL_MS=21600000

# ── Source-code leak monitoring ────────────────────────────────────────────────
# GitHub's code search API requires authentication; there is no unauthenticated
# equivalent. A personal access token with NO scopes is enough for public code
# and is free. Without it the check reports "not configured" rather than
# returning an empty result, because "no leaks" and "never looked" must not
# render the same way.
# GITHUB_TOKEN=ghp_your_token_here

# ── Browser engine for evidence capture ───────────────────────────────────────
# stock       (default) bundled Playwright + our page-level stealth patches.
# patchright  Apache-2.0, reuses the existing Chromium. Driver-level stealth,
#             BUT addInitScript is silently a no-op under it, so the page-level
#             patches (plugins, languages, permissions, WebGL) do NOT apply.
#             Install with: npm install patchright
# cloakbrowser  Wrapper is MIT; the Chromium BINARY is separately licensed —
#             v146 free, v148+ needs a paid Pro subscription, and redistribution
#             is not permitted, so it must self-download (~200MB) at runtime and
#             cannot be baked into the image.
#             Install with: npm install cloakbrowser
# CYSHIELD_BROWSER_ENGINE=stock
